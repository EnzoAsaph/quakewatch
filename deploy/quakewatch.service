[Unit]
Description=QuakeWatch Flask app (gunicorn)
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/quakewatch
Environment="PATH=/home/ubuntu/quakewatch/venv/bin"
ExecStart=/home/ubuntu/quakewatch/venv/bin/gunicorn -w 2 -b 0.0.0.0:5000 app:app
Restart=always

[Install]
WantedBy=multi-user.target
